# Backend environment
DATABASE_URL=sqlite+aiosqlite:///./slopeshield_dev.db
DATABASE_URL_SYNC=sqlite:///./slopeshield_dev.db

# Auth
JWT_SECRET_KEY=dev-secret-change-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Weather (leave blank to use DevelopmentWeatherProvider)
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.openweathermap.org

# App
APP_NAME=SlopeShield AI
APP_VERSION=1.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ML
ML_MODEL_PATH=ml/models/risk_model_v01.joblib
