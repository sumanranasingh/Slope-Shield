# Backend environment
DATABASE_URL=postgresql+asyncpg://slopeshield:slopeshield@localhost:5432/slopeshield
DATABASE_URL_SYNC=postgresql://slopeshield:slopeshield@localhost:5432/slopeshield

# Auth
JWT_SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Weather (provider-based — leave blank to use DemoWeatherProvider)
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.openweathermap.org

# App
APP_NAME=SlopeShield AI
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ML
ML_MODEL_PATH=ml/models/risk_model_v01.joblib
